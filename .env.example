# AI Configuration
# Required: The name/identifier of the AI model to use
AI_MODEL_NAME=gpt-4

# Required: The API endpoint URL for the AI service
AI_API_URL=https://api.openai.com/v1

# Required: Your API key for authentication with the AI service
AI_API_KEY=your-api-key-here

# Optional: WebContainer client token for enhanced features
# WEBCONTAINER_CLIENT_TOKEN=your-webcontainer-token-here
